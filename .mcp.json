{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${FACTORY_GITHUB_MCP_TOKEN}",
        "X-MCP-Toolsets": "repos,issues,pull_requests,labels",
        "X-MCP-Lockdown": "true"
      }
    }
  }
}
