              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The token is good and its user may not do this.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "200": {
            "description": "The provider.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProvider"
                }
              }
            }
          },
          "404": {
            "description": "No such identity provider in this tenant.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "This installation has no keys to keep the secrets of identity providers with.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/identity-providers/{provider_id}:enable": {
      "post": {
        "operationId": "enableIdentityProvider",
        "summary": "Let an identity provider sign people in again",
        "x-hodor-permission": "identity-providers:write",
        "parameters": [
          {
            "name": "provider_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "No access token, or one that is not good in this tenant. The same in every case.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The token is good and its user may not do this.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "200": {
            "description": "The provider.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProvider"
                }
              }
            }
          },
          "404": {
            "description": "No such identity provider in this tenant.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "This installation has no keys to keep the secrets of identity providers with.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "accessToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "An access token: `hodor_at_` followed by 64 hexadecimal characters."
      }
    },
    "schemas": {
      "NewUser": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "display_name": {
            "type": "string",
            "maxLength": 200
          },
          "locale": {
            "type": "string",
            "examples": [
              "pt-BR"
            ]
          }
        }
      },
      "Suspension": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "identifiers",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "human",
              "service_account",
              "agent"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "active",
              "suspended",
              "deactivated",
              "deleted"
            ]
          },
          "status_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "locale": {
            "type": [
              "string",
              "null"
            ]
          },
          "identifiers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Identifier"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Identifier": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "value",
          "verified",
          "primary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "email",
              "username"
            ]
          },
          "value": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "primary": {
            "type": "boolean"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "session_id",
          "started_at",
          "last_activity_at",
          "expires_at"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_activity_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AuditRecord": {
        "type": "object",
        "required": [
          "sequence",
          "action",
          "occurred_at",
          "recorded_at",
          "actor",
          "correlation_id",
          "details",
          "previous_hash",
          "hash"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string",
            "examples": [
              "identity.user_suspended"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "user",
                  "system",
                  "anonymous"
                ]
              },
              "id": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "type": "object"
          },
          "previous_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "A stable code for programs, for example `admin.forbidden`."
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "IdentityProvider": {
        "type": "object",
        "description": "An identity provider of the tenant. It has no field for the client secret, which no operation returns.",
        "required": [
          "id",
          "alias",
          "kind",
          "display_name",
          "issuer",
          "client_id",
          "scopes",
          "creates_users",
          "trusts_email",
          "status",
          "callback_address",
          "created_at",
          "updated_at",
          "directory"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "alias": {
            "type": "string",
            "description": "The provider's name in addresses. It never changes."
          },
          "kind": {
            "type": "string",
            "enum": [
              "openid_connect",
              "github",
              "ldap"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "client_id": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "creates_users": {
            "type": "boolean",
            "description": "Whether a person nobody knows yet is created on first sign-in."
          },
          "status": {
            "type": "string",
            "enum": [
              "enabled",
              "disabled"
            ]
          },
          "callback_address": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "The address to register at the provider. `null` for a directory, which nobody leaves for."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "trusts_email": {
            "type": "boolean",
            "description": "Whether every address the provider gives is taken as vouched for, even when the provider does not say so."
          },
          "directory": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DirectorySettings"
              },
              {
                "type": "null"
              }
            ],
            "description": "What only a directory has; `null` for every other kind."
          }
        }
      },
      "NewIdentityProvider": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "display_name",
          "client_id",
          "client_secret"
        ],
        "properties": {
          "alias": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "issuer": {
            "type": "string",
            "format": "uri",
            "description": "May be left out for the kind `github`."
          },
          "client_id": {
            "type": "string"
          },
          "client_secret": {
            "type": "string",
            "writeOnly": true
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "creates_users": {
            "type": "boolean"
          },
          "kind": {
            "type": "string",
            "enum": [
              "openid_connect",
              "github",
              "ldap"
            ],
            "default": "openid_connect"
          },
          "trusts_email": {
            "type": "boolean",
            "default": false
          },
          "directory": {
            "$ref": "#/components/schemas/DirectoryInput"
          }
        }
      },
      "IdentityProviderChanges": {
        "type": "object",
        "additionalProperties": false,
        "description": "What is left out stays as it is.",
        "properties": {
          "display_name": {
            "type": "string"
          },
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "client_id": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "creates_users": {
            "type": "boolean"
          },
          "trusts_email": {
            "type": "boolean"
          },
          "directory": {
            "$ref": "#/components/schemas/DirectoryInput"
          }
        }
      },
      "ClientSecret": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "client_secret"
        ],
        "properties": {
          "client_secret": {
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "DirectorySettings": {
        "type": "object",
        "required": [
          "base",
          "filter",
          "subject_attribute",
          "email_attribute",
          "name_attribute"
        ],
        "properties": {
          "base": {
            "type": "string"
          },
          "filter": {
            "type": "string"
          },
          "subject_attribute": {
            "type": "string"
          },
          "email_attribute": {
            "type": "string"
          },
          "name_attribute": {
            "type": "string"
          }
        }
      },
      "DirectoryInput": {
        "type": "object",
        "additionalProperties": false,
        "description": "What is left out is `entryUUID`, `mail` and `cn` for the attribute names, or, in a change, what it was.",
        "properties": {
          "base": {
            "type": "string"
          },
          "filter": {
            "type": "string"
          },
          "subject_attribute": {
            "type": "string"
          },
          "email_attribute": {
            "type": "string"
          },
          "name_attribute": {
            "type": "string"
          }
        }
      }
    }
  }
}
