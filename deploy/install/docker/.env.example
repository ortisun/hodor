# The settings of a Hodor installation with Docker. Copy this file to `.env`, in the same folder, and fill
# it in. `.env` holds passwords and keys: git ignores it, and it should be readable by you alone.
#
# Each step is explained in docs/operations/install-with-docker.md.

# --- What runs -------------------------------------------------------------------------------------------

# The Hodor image, built from this checkout or pulled from your registry.
HODOR_IMAGE=hodor:0.2.0

# The optional parts, separated by commas:
#   database   PostgreSQL in a container. Remove it to use a database of your own.
#   https      A web server that gets a certificate for HODOR_PUBLIC_URL. Remove it to use your own.
COMPOSE_PROFILES=database,https

# --- The address -----------------------------------------------------------------------------------------

# Where people reach Hodor: https, the name, no path. With the profile `https`, the name must already
# point at this machine, and ports 80 and 443 must be reachable from the internet.
HODOR_PUBLIC_URL=

# --- Secrets ---------------------------------------------------------------------------------------------

# One password per database role, letters and digits only because they are written into addresses.
# Make each one with:  openssl rand -hex 24
HODOR_OWNER_DATABASE_PASSWORD=
HODOR_SERVER_DATABASE_PASSWORD=
HODOR_WORKER_DATABASE_PASSWORD=

# The key that keeps the secrets of identity providers and the signing keys encrypted, as identifier:key.
# The identifier is a name you choose, in lower case letters, digits and hyphens. Make the key with:
#   docker run --rm --entrypoint /usr/local/bin/hodor-cli hodor:0.2.0 secrets generate-key
# Keep a copy somewhere safe: without it, what it encrypted cannot be read again.
HODOR_SECRET_KEYS=

# --- A database of your own (without the profile `database`) ---------------------------------------------

# Its host and port, the name of the database, and anything to add to the connection address.
#HODOR_DATABASE_ADDRESS=database.example.com:5432
#HODOR_DATABASE_NAME=hodor
#HODOR_DATABASE_OPTIONS=?sslmode=verify-full

# --- Mail ------------------------------------------------------------------------------------------------

# The mail server that delivers Hodor's messages, and the address they come from. Without these, messages
# wait in the database and nobody receives a verification or recovery link.
#HODOR_SMTP_URL=smtps://user:password@mail.example.com:465
#HODOR_MAIL_FROM=Hodor <no-reply@example.com>

# --- Optional --------------------------------------------------------------------------------------------

# The port the server is published on, on this machine only.
#HODOR_HTTP_PORT=8080

# The LDAP directories identity providers may name, as host:port separated by commas.
#HODOR_DIRECTORY_HOSTS=directory.example.com:636

# Where metrics and traces are sent, over OTLP/HTTP. Unset: none are sent.
#HODOR_OTLP_METRICS_ENDPOINT=http://victoriametrics.example.com:8428/opentelemetry/v1/metrics
#HODOR_OTLP_TRACES_ENDPOINT=http://victoriatraces.example.com:10428/insert/opentelemetry/v1/traces

# Password hashes computed at the same time; each uses about 19 MiB. Default: one per processor core.
#HODOR_PASSWORD_HASH_CONCURRENCY=4

# How often the signing keys change: days a key signs, hours its successor is published before it signs,
# hours a replaced key stays published. Defaults: 90, 24, 24.
#HODOR_KEY_ROTATION_DAYS=90
#HODOR_KEY_PUBLICATION_HOURS=24
#HODOR_KEY_OVERLAP_HOURS=24

# Seconds a refresh token used once is answered again, with the same next token, for a client that lost
# its answer: 0 to 60, 0 turns that off. Default: 10.
#HODOR_REFRESH_RETRY_SECONDS=10

# Logs: `json` (the default) or `pretty`, and what is logged.
#HODOR_LOG_FORMAT=json
#HODOR_LOG_FILTER=info
