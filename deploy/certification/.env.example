# The settings of the certification deployment. Copy this file to `.env`, in
# the same folder, and fill it in. Every secret is new, made for this
# deployment alone: the logs of the hosted suite are published.
#
# docs/operations/certification-deployment.md says each step.

# --- What runs -------------------------------------------------------------

# The Hodor image of the version to certify. Its version is the one the
# Certification of Conformance names.
HODOR_IMAGE=ghcr.io/ortisun/hodor:0.5.0

# PostgreSQL in a container, and the web server of Caddyfile. Both are needed.
COMPOSE_PROFILES=database,https

# --- The address -----------------------------------------------------------

# Where the hosted suite and the owner's browser reach Hodor: https, the name,
# no path. The name must point at this host, and ports 80 and 443 must be
# reachable from the internet.
HODOR_PUBLIC_URL=

# --- Secrets ---------------------------------------------------------------

# One password per database role, letters and digits only. Make each one
# with:  openssl rand -hex 24
HODOR_OWNER_DATABASE_PASSWORD=
HODOR_SERVER_DATABASE_PASSWORD=
HODOR_WORKER_DATABASE_PASSWORD=

# The key that keeps the tenants' keys and secrets encrypted, as
# identifier:key. Make the key with:
#   docker run --rm --entrypoint /usr/local/bin/hodor-cli "$HODOR_IMAGE" secrets generate-key
HODOR_SECRET_KEYS=

# --- Optional --------------------------------------------------------------

# The port of the mail server's interface, on this host alone.
#CERTIFICATION_MAIL_PORT=8025

# The settings of the script, certification.mjs, may be written here too:
# CERTIFICATION_ALIAS, CERTIFICATION_PERSON_EMAIL, CERTIFICATION_SUITE_URL.
