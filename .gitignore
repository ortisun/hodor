/target
.env
.DS_Store

# The development SAML identity provider signs with a key that is written in
# the repository on purpose: see deploy/dev-saml-provider/README.md. A rule
# elsewhere that ignores every PEM file must not keep it out.
!deploy/dev-saml-provider/*.pem

# The documentation site: its Python environment and what `mkdocs build` writes.
/site/.venv
/site/build

# What the test environments start and keep on this machine.
deploy/test-environment/.local/

# The OpenID conformance run: its dependencies and the results it writes.
deploy/conformance/node_modules/
deploy/conformance/conformance-results.json

# Leftovers of patch and of merge tools
*.orig
*.rej
